{
  "name": "ferro-launcher",
  "version": "0.9.4",
  "description": "FerroLauncher - Launcher de Minecraft hecho desde 0",
  "author": "Adrian Garcia Martinez",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "lint": "eslint . --max-warnings 166",
    "test": "node scripts/run-tests.js",
    "test:docs": "node scripts/docs-version.js --check",
    "check": "npm run lint && npm run test && npm run test:docs && npm run build",
    "docs:version": "node scripts/docs-version.js",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:full": "npm run build && electron-builder --win --dir && node scripts/brand-exe.js && node scripts/app-update-yml.js && electron-builder --win nsis portable --prepackaged release\\win-unpacked",
    "start": "electron ."
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.42.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "rcedit": "^5.0.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "esbuild@0.25.12": true
  },
  "build": {
    "appId": "com.ferro.launcher",
    "productName": "FerroLauncher",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "core/**/*",
      "dist/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "FerroLauncher",
      "artifactName": "FerroLauncher-Setup.exe"
    },
    "portable": {
      "artifactName": "FerroLauncher-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "4DRI4N-OFF",
      "repo": "FerroLauncher",
      "releaseType": "release"
    }
  }
}
