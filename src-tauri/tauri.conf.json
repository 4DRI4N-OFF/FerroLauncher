{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FerroLauncher",
  "version": "0.9.6",
  "identifier": "com.ferro.launcher.tauri",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FerroLauncher",
        "width": 1100,
        "height": 700,
        "backgroundColor": "#0d0908"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
